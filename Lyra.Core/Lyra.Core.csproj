<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>LyraViewer</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Lyra</RootNamespace>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" Version="3.4.14.1" />
    <PackageReference Include="SDL3-CS.Native" Version="3.4.2" />
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1" />
    <PackageReference Include="Svg.Skia" Version="5.2.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lyra.Common\Lyra.Common.csproj" />
    <ProjectReference Include="..\Lyra.Imaging\Lyra.Imaging.csproj" />
    <ProjectReference Include="..\Lyra.UI\Lyra.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\AppIcon.png">
      <LogicalName>LyraViewer.AppIcon.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\JetBrainsMono-Regular.ttf">
      <LogicalName>LyraViewer.Fonts.JetBrainsMono-Regular.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\JetBrainsMono-Bold.ttf">
      <LogicalName>LyraViewer.Fonts.JetBrainsMono-Bold.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\OFL.txt">
      <LogicalName>LyraViewer.Fonts.OFL.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Shaders\HdrToneMap.sksl">
      <LogicalName>LyraViewer.Shaders.HdrToneMap.sksl</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <NativeDistSubdir Condition="$([MSBuild]::IsOSPlatform('Linux'))">dist-linux</NativeDistSubdir>
    <NativeDistSubdir Condition="$([MSBuild]::IsOSPlatform('OSX'))">dist-macos</NativeDistSubdir>
    <NativeDistSubdir Condition="$([MSBuild]::IsOSPlatform('Windows'))">dist-windows</NativeDistSubdir>
    
    <NativeLibFolder Condition="$([MSBuild]::IsOSPlatform('Linux'))">Linux</NativeLibFolder>
    <NativeLibFolder Condition="$([MSBuild]::IsOSPlatform('OSX'))">macOS</NativeLibFolder>
    <NativeLibFolder Condition="$([MSBuild]::IsOSPlatform('Windows'))">Windows</NativeLibFolder>
  </PropertyGroup>

  <Target Name="LyraSyncNativeWrappersToOutput" AfterTargets="Build"
          Condition="'$(NativeDistSubdir)' != '' AND Exists('$(MSBuildThisFileDirectory)..\release\native\$(NativeDistSubdir)')">
    <ItemGroup>
      <_LyraNativeWrapperFiles Include="$(MSBuildThisFileDirectory)..\release\native\$(NativeDistSubdir)\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_LyraNativeWrapperFiles)" DestinationFolder="$(OutDir)lib\$(NativeLibFolder)\" SkipUnchangedFiles="true" Condition="'@(_LyraNativeWrapperFiles)' != ''" />
  </Target>


  <ItemGroup>
    <InternalsVisibleTo Include="Lyra.Core.Tests" />
  </ItemGroup>

</Project>
