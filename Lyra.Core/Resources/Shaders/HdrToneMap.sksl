uniform shader image;
uniform shader toneLut;
uniform float toneLutSize;
uniform float3x3 toWorking;
uniform float3x3 fromWorking;
uniform float exposure;
uniform float whitePoint;
uniform float mode;
uniform float3x3 gamut;

uniform float4 encodeGABC;
uniform float3 encodeDEF;

uniform float3 lumaWeights;

uniform float ceiling;

uniform float sceneWhite;
uniform float peak;

uniform float encoding;

float encodeChannel(float linear) {
    float g = encodeGABC.x;
    float a = encodeGABC.y;
    float b = encodeGABC.z;
    float c = encodeGABC.w;
    float d = encodeDEF.x;
    float e = encodeDEF.y;
    float f = encodeDEF.z;

    if (a <= 0.0 || g <= 0.0) {
        return linear;
    }

    float joint = c * d + f;

    if (linear < joint) {
        return c > 0.0 ? (linear - f) / c : 0.0;
    }

    return (pow(max(linear - e, 0.0), 1.0 / g) - b) / a;
}

float expandChannel(float stored) {
    float v = stored <= 0.04045 ? stored / 12.92 : pow((stored + 0.055) / 1.055, 2.4);
    v = clamp(v, 0.0, 1023.0 / 1024.0);
    return v / (1.0 - v);
}

float acesCurve(float x) {
    return (x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14);
}

float reinhardCurve(float x, float white) {
    float w2 = white * white;
    return x * (1.0 + x / w2) / (1.0 + x);
}

float cameraTone(float v) {
    return toneLut.eval(float2(clamp(v, 0.0, 1.0) * (toneLutSize - 1.0) + 0.5, 0.5)).r;
}

float3 cameraToneRgb(float3 w) {
    float lo = min(w.r, min(w.g, w.b));
    float hi = max(w.r, max(w.g, w.b));
    float toneLo = cameraTone(lo);
    float toneHi = cameraTone(hi);
    return hi > lo ? toneLo + (toneHi - toneLo) * (w - lo) / (hi - lo) : float3(toneLo);
}

const float highlightKnee = 0.8;

float spendHeadroom(float mapped, float ceiling) {
    if (ceiling <= 1.0 || mapped <= highlightKnee) {
        return mapped;
    }

    float intoHighlights = (mapped - highlightKnee) / (1.0 - highlightKnee);

    return highlightKnee + (ceiling - highlightKnee) * intoHighlights;
}

half4 main(float2 coord) {
    half4 src = image.eval(coord);
    float3 light = float3(src.rgb);
    if (encoding > 0.5) {
        light = float3(expandChannel(light.r), expandChannel(light.g), expandChannel(light.b));
    }
    float3 scene = max(light * exposure, float3(0.0));
    float3 x = max(gamut * scene, float3(0.0));

    float top = peak > 0.0 ? min(ceiling, max(peak, 1.0)) : ceiling;

    float3 mapped;
    if (mode < 0.5 && toneLutSize > 0.0) {
        float3 toned = cameraToneRgb(clamp(toWorking * scene, 0.0, 1.0));
        mapped = max(fromWorking * toned, float3(0.0));

        float brightest = max(mapped.r, max(mapped.g, mapped.b));
        if (brightest > 1e-5) {
            mapped *= spendHeadroom(brightest, top) / brightest;
        }
    } else if (mode > 1.5) {
        mapped = sceneWhite > 0.0 ? x / sceneWhite : x;
    } else {
        float luminance = max(dot(x, lumaWeights), 0.0);
        float white = sceneWhite > 0.0 ? sceneWhite * exposure : whitePoint;
        float curved = (mode > 0.5) ? reinhardCurve(luminance, white) : acesCurve(luminance);
        if (mode < 0.5 && sceneWhite > 0.0) {
            curved /= acesCurve(sceneWhite);
        }

        float target = spendHeadroom(curved, top);

        mapped = luminance > 1e-5 ? x * (target / luminance) : float3(0.0);

        float brightest = max(mapped.r, max(mapped.g, mapped.b));
        if (brightest > top) {
            float t = clamp((brightest - top) / max(brightest - target, 1e-5), 0.0, 1.0);
            mapped = mix(mapped, float3(target), t);
        }
    }

    mapped = clamp(mapped, float3(0.0), float3(top));

    mapped = float3(encodeChannel(mapped.r), encodeChannel(mapped.g), encodeChannel(mapped.b));

    return half4(half3(mapped * float(src.a)), src.a);
}