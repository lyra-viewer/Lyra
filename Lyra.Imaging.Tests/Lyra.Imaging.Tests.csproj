<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <RootNamespace>Lyra.Imaging.Tests</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="xunit.v3" Version="3.2.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.1" />
        <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.152.1" />
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.152.1" />
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\Lyra.Imaging\Lyra.Imaging.csproj" />
    </ItemGroup>

    <!-- Owned by the ManagedCodecs tests, where the GIF, WebP, APNG, ISO track and TGA readers are tested; the decoder tests here share them. -->
    <ItemGroup>
        <Compile Include="..\Lyra.ManagedCodecs.Tests\src\Gif\GifBuilder.cs" Link="src\Support\GifBuilder.cs" />
        <Compile Include="..\Lyra.ManagedCodecs.Tests\src\Webp\WebpBuilder.cs" Link="src\Support\WebpBuilder.cs" />
        <Compile Include="..\Lyra.ManagedCodecs.Tests\src\Png\ApngBuilder.cs" Link="src\Support\ApngBuilder.cs" />
        <Compile Include="..\Lyra.ManagedCodecs.Tests\src\Heif\HeifSequenceFixtures.cs" Link="src\Support\HeifSequenceFixtures.cs" />
        <Compile Include="..\Lyra.ManagedCodecs.Tests\src\Tga\TgaTestImage.cs" Link="src\Support\TgaTestImage.cs" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="src\" />
    </ItemGroup>

</Project>
